# Copie para .env e preencha com as credenciais do projeto Firebase.
# Variaveis EXPO_PUBLIC_* ficam visiveis no bundle do app (nunca coloque segredos privados).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# true = usa dados de src/mocks como fallback; false = consulta apenas o Firestore
EXPO_PUBLIC_USE_MOCKS=true
