{
  "expo": {
    "name": "ShopGo",
    "slug": "shopgo",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "shopgo",
    "userInterfaceStyle": "light",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF5A1F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.victorzendem.shopgo"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O ShopGo precisa acessar suas fotos para escolher a foto de perfil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12264B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "70ef0f3e-3e54-4986-80f8-e52fa97fc0bf"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/70ef0f3e-3e54-4986-80f8-e52fa97fc0bf"
    }
  }
}
